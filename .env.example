DB_USER=postgres
DB_HOST=localhost
DB_NAME=plateup
DB_PASSWORD=replace_with_your_database_password
DB_PORT=5432
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
# Optional restaurant instructions for settling platform fees. No payment gateway is connected.
BILLING_PAYMENT_INSTRUCTIONS=Arrange payment with the PlateUp platform owner and retain your receipt reference.
# Optional absolute Python executable for item model training (default: python).
ML_PYTHON=python

# Password-reset email (optional until a mail provider is configured).
# Use your public HTTPS origin in production; never derive reset URLs from a request header.
APP_ORIGIN=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
